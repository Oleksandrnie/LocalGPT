{
  "id": "tailscale",
  "name": "Tailscale Remote Access",
  "type": "runtime_connectivity",
  "version": "0.1.0",
  "enabled_by_default": false,
  "description": "Official/internal metadata plugin for private tailnet access to the local LocalGPT UI through Tailscale Serve.",
  "permissions": [
    "read_runtime_status",
    "read_tailscale_status",
    "read_tailscale_serve_status",
    "provide_network_address"
  ],
  "dangerous_permissions": [
    "manual_remote_access_setup_required",
    "tailnet_devices_can_reach_localgpt_after_tailscale_serve_is_enabled"
  ],
  "docs": [
    "README.md",
    "docs/remote-access-tailscale.md",
    "docs/how-to-use-tailscale-mode.md"
  ]
}
