# === Base paths ===
MODELS_DIR=models
WHISPER_MODELS_DIR=models/whisper
HF_CACHE_DIR=models/hf_cache
CTRANSLATE2_CACHE_DIR=models/ctranslate2_cache
TRANSCRIPTS_DIR=app/data/transcripts

# === Whisper ===
WHISPER_MODEL_SIZE=small
WHISPER_COMPUTE_TYPE=auto
WHISPER_DEVICE=auto
WHISPER_BEAM_SIZE=5
WHISPER_FALLBACK_LANGUAGE=ru
HF_ENDPOINT=https://huggingface.co
# Optional fallback endpoint if primary is blocked in your network.
# Example: HF_FALLBACK_ENDPOINT=https://hf-mirror.com
HF_FALLBACK_ENDPOINT=
# Use proxy vars from environment (HTTP_PROXY/HTTPS_PROXY). 0 = ignore env proxy.
HF_TRUST_ENV=0

# === Service ===
ENV=local
