# === Основные пути хранения моделей и кэшей ===
# Можно указывать относительные пути от корня проекта или абсолютные пути.
MODELS_DIR=models
OLLAMA_MODELS_DIR=models/ollama
WHISPER_MODELS_DIR=models/whisper
TTS_MODELS_DIR=models/tts
PIPER_MODELS_DIR=models/tts/piper
HF_CACHE_DIR=models/hf_cache
CTRANSLATE2_CACHE_DIR=models/ctranslate2_cache

# === Параметры LLM (Ollama / OpenAI-compatible endpoint) ===
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=LOCAL-KEY
# Не задавайте LOCAL_MODEL, если модель ещё не загружена локально.
LOCAL_MODEL=

TEMP=0.2
MAX_TOKENS=2048
NUM_CTX=32768
MEM_TURNS=6

# === Whisper / ASR ===
WHISPER_MODEL_SIZE=large-v3-turbo
# whisper_cpp = основной режим для разгрузки CPU через whisper.cpp Metal/CoreML.
# auto = использовать whisper.cpp, если найден whisper-cli и GGML-модель; иначе faster-whisper.
# faster_whisper = Python/CTranslate2 fallback.
WHISPER_BACKEND=whisper_cpp
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_BEAM_SIZE=5
WHISPER_FALLBACK_LANGUAGE=ru

# === whisper.cpp / ASR acceleration on Apple Silicon ===
# Требуется отдельный whisper.cpp `whisper-cli`, собранный с Metal/CoreML.
# GGML-модели кладутся отдельно от faster-whisper моделей.
WHISPER_CPP_BINARY=models/whisper_cpp/bin/whisper-cli
WHISPER_CPP_MODELS_DIR=models/whisper_cpp
# Можно указать точный файл или шаблон с {model}, например:
# WHISPER_CPP_MODEL_PATH=models/whisper_cpp/ggml-{model}.bin
WHISPER_CPP_MODEL_PATH=
WHISPER_CPP_THREADS=4
WHISPER_CPP_EXTRA_ARGS=
WHISPER_CPP_CONVERT_AUDIO=1
WHISPER_CPP_FFMPEG_BINARY=ffmpeg
WHISPER_CPP_DOWNLOAD_COREML=1
TRANSCRIBE_LOG_MAX_BYTES=2097152

# === LAN / Caddy ===
# По умолчанию LocalGPT слушает только localhost. Для LAN launcher backend остаётся
# на localhost, а Caddy открывает HTTPS-доступ внутри локальной сети.
LOCALGPT_HOST=127.0.0.1
LOCALGPT_PORT=8000
LOCALGPT_REMOTE_ACCESS=false
LOCALGPT_REMOTE_ACCESS_MODE=local
# Опционально можно зафиксировать внешний LAN URL и HTTPS-порт для телефона.
LAN_ACCESS_URL=
LAN_HTTPS_PORT=8443

# CORS по умолчанию не открыт на весь интернет: штатный UI работает same-origin.
# Добавляйте origins только если осознанно запускаете отдельный frontend/dev host.
LOCALGPT_CORS_ALLOW_ORIGINS=
LOCALGPT_CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\]|192\.168\.\d{1,3}\.\d{1,3}|10\.\d{1,3}\.\d{1,3}\.\d{1,3}|172\.(1[6-9]|2\d|3[01])\.\d{1,3}\.\d{1,3}|100\.(6[4-9]|[7-9]\d|1[01]\d|12[0-7])\.\d{1,3}\.\d{1,3}|[a-z0-9.-]+\.local)(:[0-9]+)?$

# === TTS / Voice ===
TTS_ENABLED=1
TTS_DEFAULT_PROVIDER=piper
TTS_DATA_DIR=app/data/tts
TTS_OUTPUT_DIR=app/data/tts/output
TTS_HISTORY_DIR=app/data/tts/history
TTS_TEMP_DIR=app/data/tts/temp
TTS_AUDIO_FORMAT=wav
TTS_MAX_TEXT_CHARS=15000
TTS_SPEED_OPTIONS=1.0,1.25,1.5,1.75,2.0

# === Прочее ===
ADMIN_TOKEN=
ENV=local
