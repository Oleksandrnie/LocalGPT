# === Основные настройки моделей ===
# Укажите путь к директории, где хранятся модели.
# Можно задать абсолютный путь, если модели находятся на другом диске.
MODELS_DIR=models

# Путь к моделям Whisper (для распознавания речи)
WHISPER_MODELS_DIR=models/whisper

# Путь к моделям Ollama (если используется локальное хранение)
OLLAMA_MODELS_DIR=models/ollama

# Кэши для офлайна (Hugging Face и ctranslate2)
HF_CACHE_DIR=models/hf_cache
CTRANSLATE2_CACHE_DIR=models/ctranslate2_cache

# === Параметры LLM (Ollama / OpenAI-совместимые) ===
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=LOCAL-KEY
LOCAL_MODEL=qwen2.5:3b

TEMP=0.2
MAX_TOKENS=2048
NUM_CTX=32768
MEM_TURNS=6

# === Whisper (ASR) ===
WHISPER_MODEL_SIZE=medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_FALLBACK_LANGUAGE=ru

# === Сервисные опции ===
ADMIN_TOKEN=local-admin-123
ENV=local
