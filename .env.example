# === Основные пути хранения моделей и кэшей ===
# Можно указывать относительные пути от корня проекта или абсолютные пути.
MODELS_DIR=models
OLLAMA_MODELS_DIR=models/ollama
WHISPER_MODELS_DIR=models/whisper
TTS_MODELS_DIR=models/tts
PIPER_MODELS_DIR=models/tts/piper
HF_CACHE_DIR=models/hf_cache
CTRANSLATE2_CACHE_DIR=models/ctranslate2_cache

# === Параметры LLM (Ollama / OpenAI-compatible endpoint) ===
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=LOCAL-KEY
LOCAL_MODEL=qwen2.5:3b

TEMP=0.2
MAX_TOKENS=2048
NUM_CTX=32768
MEM_TURNS=6

# === Whisper / ASR ===
WHISPER_MODEL_SIZE=medium
WHISPER_COMPUTE_TYPE=int8
WHISPER_DEVICE=cpu
WHISPER_BEAM_SIZE=5
WHISPER_FALLBACK_LANGUAGE=ru

# === LAN / Caddy ===
# Опционально можно зафиксировать внешний LAN URL и HTTPS-порт для телефона.
LAN_ACCESS_URL=
LAN_HTTPS_PORT=8443

# === TTS / Voice ===
TTS_ENABLED=1
TTS_DEFAULT_PROVIDER=piper
TTS_DATA_DIR=app/data/tts
TTS_OUTPUT_DIR=app/data/tts/output
TTS_HISTORY_DIR=app/data/tts/history
TTS_TEMP_DIR=app/data/tts/temp
TTS_AUDIO_FORMAT=wav
TTS_MAX_TEXT_CHARS=15000
TTS_SPEED_OPTIONS=1.0,1.25,1.5,1.75,2.0

# === Прочее ===
ADMIN_TOKEN=
ENV=local
