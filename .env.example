# === Base paths ===
MODELS_DIR=models
# Models will be stored as: models/<model_name>/...
WHISPER_MODELS_DIR=models
HF_HOME=models/huggingface
HF_CACHE_DIR=models/huggingface/hub
HUGGINGFACE_HUB_CACHE=models/huggingface/hub
CTRANSLATE2_CACHE_DIR=models/ctranslate2_cache
TRANSCRIPTS_DIR=app/data/transcripts

# === Whisper ===
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_COMPUTE_TYPE=auto
WHISPER_DEVICE=auto
WHISPER_BEAM_SIZE=5
WHISPER_FALLBACK_LANGUAGE=ru
HF_ENDPOINT=https://huggingface.co
# Fallback endpoint if primary is blocked in your network.
HF_FALLBACK_ENDPOINT=https://hf-mirror.com
# Use proxy vars from environment (HTTP_PROXY/HTTPS_PROXY). 0 = ignore env proxy.
HF_TRUST_ENV=0
# Optional import source for already downloaded home cache.
WHISPER_IMPORT_CACHE_DIR=~/.cache/huggingface/hub
# Optional Hugging Face token (read scope, ASCII only, usually starts with hf_).
HF_TOKEN=

# === Service ===
ENV=local
# Optional fixed URL used in desktop shortcut hint for iPhone.
IOS_ACCESS_URL=
# Port used to build iPhone URL when IOS_ACCESS_URL is empty.
IOS_HTTPS_PORT=8443
