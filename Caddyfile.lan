{
	admin off
}

# Static localhost fallback example only.
# The LAN launcher writes a generated Caddyfile with the current LAN IP to the runtime directory.
https://localhost:8443, https://127.0.0.1:8443 {
	tls internal
	reverse_proxy 127.0.0.1:{$LOCALGPT_PORT:8000} {
		lb_try_duration 5s
		lb_try_interval 250ms
		flush_interval -1
	}
}
